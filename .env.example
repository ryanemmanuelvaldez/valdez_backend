# Copy this file to .env and update the values below

# Application Settings
APP_NAME=RentEase
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rentease
DB_CHARSET=utf8mb4
DB_PREFIX=

# Used once by db:migrate to create the single admin row in users.
# Set these locally; do not expose them in frontend code or commit BackendLL/.env.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail SMTP (use a Google App Password; never use your regular Gmail password).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_ADDRESS=
GMAIL_SMTP_TIMEOUT=15

# Xendit Payments API (online GCash/Maya only). Keep keys server-side.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_MODE=test
FRONTEND_URL=http://localhost/FinalProjects/Frontend/dist/

# Exact comma-separated frontend origins allowed to call the API with session cookies.
API_ALLOWED_ORIGINS=https://ryvaldez-frontend.onrender.com,http://localhost:5173
SESSION_COOKIE_SAMESITE=Strict

# JWT values are only needed if the framework API helper is enabled.
JWT_SECRET=
REFRESH_TOKEN_KEY=